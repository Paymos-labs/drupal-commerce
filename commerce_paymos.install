<?php

/** @file Native module schema and lifecycle. */
function commerce_paymos_schema(): array {
  return commerce_paymos_refund_schema() + commerce_paymos_invoice_history_schema() + [
    'commerce_paymos_invoice' => [
      'description' => 'Durable Paymos order intents and verified invoice bindings.',
      'fields' => [
        'order_id' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'invoice_id' => ['type'=>'varchar','length'=>128,'not null'=>FALSE],
        'data' => ['type'=>'blob','size'=>'big','not null'=>TRUE],
        'credited' => ['type'=>'int','size'=>'tiny','not null'=>TRUE,'default'=>0],
        'updated' => ['type'=>'int','not null'=>TRUE],
        'checked' => ['type'=>'int','not null'=>TRUE,'default'=>0],
      ],
      'primary key' => ['order_id'],
      'unique keys' => ['invoice' => ['invoice_id']],
      'indexes' => ['pending' => ['credited','checked']],
    ],
    'commerce_paymos_event' => [
      'description' => 'Events committed atomically with native payment effects.',
      'fields' => [
        'event_id' => ['type'=>'varchar','length'=>128,'not null'=>TRUE],
        'committed' => ['type'=>'int','not null'=>TRUE],
      ],
      'primary key' => ['event_id'],
    ],
  ];
}

/** Historical bindings survive replacement of the current checkout intent. */
function commerce_paymos_invoice_history_schema(): array {
  return ['commerce_paymos_invoice_history' => [
    'fields' => [
      'invoice_id' => ['type'=>'varchar','length'=>128,'not null'=>TRUE],
      'order_id' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
      'data' => ['type'=>'blob','size'=>'big','not null'=>TRUE],
      'status' => ['type'=>'varchar','length'=>32,'not null'=>TRUE],
      'late_noted' => ['type'=>'int','size'=>'tiny','not null'=>TRUE,'default'=>0],
      'updated' => ['type'=>'int','not null'=>TRUE],
      'checked' => ['type'=>'int','not null'=>TRUE,'default'=>0],
    ],
    'primary key' => ['invoice_id'],
    'indexes' => ['order'=>['order_id'], 'pending'=>['late_noted','checked']],
  ]];
}

/** Add history without altering any existing invoice or payment binding. */
function commerce_paymos_update_10002(): void {
  $schema = \Drupal::database()->schema();
  foreach (commerce_paymos_invoice_history_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) { $schema->createTable($table,$definition); }
  }
}

/** Refund history is independent of the current payment projection. */
function commerce_paymos_refund_schema(): array {
  return [
    'commerce_paymos_refund' => [
      'fields' => [
        'operation_id' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'installation_id' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'request_token' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'payment_key' => ['type'=>'varchar','length'=>128,'not null'=>TRUE],
        'external_id' => ['type'=>'varchar','length'=>200,'not null'=>TRUE],
        'withdrawal_id' => ['type'=>'varchar','length'=>128,'not null'=>FALSE],
        'data' => ['type'=>'blob','size'=>'big','not null'=>TRUE],
        'due' => ['type'=>'int','size'=>'big','not null'=>TRUE],
        'created' => ['type'=>'int','size'=>'big','not null'=>TRUE],
      ],
      'primary key' => ['operation_id'],
      'unique keys' => ['request'=>['installation_id','request_token'], 'external'=>['external_id'], 'withdrawal'=>['withdrawal_id']],
      'indexes' => ['payment'=>['payment_key'], 'due'=>['due','operation_id']],
    ],
    'commerce_paymos_refund_projection' => [
      'fields' => [
        'operation_id' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'payment_key' => ['type'=>'varchar','length'=>128,'not null'=>TRUE],
        'external' => ['type'=>'int','size'=>'tiny','not null'=>TRUE,'default'=>0],
        'checked' => ['type'=>'int','size'=>'big','not null'=>TRUE,'default'=>0],
        'data' => ['type'=>'blob','size'=>'big','not null'=>TRUE],
      ],
      'primary key' => ['operation_id'],
      'indexes' => ['payment'=>['payment_key'], 'sweep'=>['external','checked']],
    ],
    'commerce_paymos_refund_lock' => [
      'fields' => [
        'payment_key' => ['type'=>'varchar','length'=>128,'not null'=>TRUE],
        'owner' => ['type'=>'varchar','length'=>64,'not null'=>TRUE],
        'expires' => ['type'=>'int','size'=>'big','not null'=>TRUE],
      ],
      'primary key' => ['payment_key'],
    ],
  ];
}

/** Add mode-bound intents without rewriting existing payment bindings. */
function commerce_paymos_update_10001(): void {
  $schema = \Drupal::database()->schema();
  foreach (commerce_paymos_refund_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) { $schema->createTable($table, $definition); }
  }
}
function commerce_paymos_uninstall(): void {
  \Drupal::state()->delete('commerce_paymos.connection');
  \Drupal::state()->delete('commerce_paymos.device');
  \Drupal::keyValue('commerce_paymos.previous_invoice')->deleteAll();
}
